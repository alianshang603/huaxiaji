\"533.3\" y2=\"82\" stroke=\"#4e7256\" stroke-width=\"1.5\" opacity=\"0.5\"/><circle cx=\"533.3\" cy=\"82\" r=\"5\" fill=\"#4e7256\"/><text x=\"533.3\" y=\"64\" font-size=\"9\" text-anchor=\"middle\" class=\"t-gold\">1279</text><text x=\"533.3\" y=\"102\" font-size=\"11\" text-anchor=\"middle\" class=\"t-strong\">崖山</text><text x=\"533.3\" y=\"118\" font-size=\"10.5\" text-anchor=\"middle\" fill=\"var(--ink2)\">南宋</text><line x1=\"602.7\" y1=\"70\" x2=\"602.7\" y2=\"82\" stroke=\"#4e7256\" stroke-width=\"1.5\" opacity=\"0.5\"/><circle cx=\"602.7\" cy=\"82\" r=\"5\" fill=\"#4e7256\"/><text x=\"602.7\" y=\"64\" font-size=\"9\" text-anchor=\"middle\" class=\"t-gold\">1363</text><text x=\"602.7\" y=\"102\" font-size=\"11\" text-anchor=\"middle\" class=\"t-strong\">鄱阳湖</text><text x=\"602.7\" y=\"118\" font-size=\"10.5\" text-anchor=\"middle\" fill=\"var(--ink2)\">元末</text><line x1=\"672.0\" y1=\"70\" x2=\"672.0\" y2=\"82\" stroke=\"#4e7256\" stroke-width=\"1.5\" opacity=\"0.5\"/><circle cx=\"672.0\" cy=\"82\" r=\"5\" fill=\"#4e7256\"/><text x=\"672.0\" y=\"64\" font-size=\"9\" text-anchor=\"middle\" class=\"t-gold\">1619</text><text x=\"672.0\" y=\"102\" font-size=\"11\" text-anchor=\"middle\" class=\"t-strong\">萨尔浒</text><text x=\"672.0\" y=\"118\" font-size=\"10.5\" text-anchor=\"middle\" fill=\"var(--ink2)\">明末</text></svg></div>"}