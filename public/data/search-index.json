:"ming","col":"#9c2b22"},{"y":"1449","t":"土木之变","desc":"英宗亲征瓦剌大败被俘，京师震动。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1449","t":"北京保卫战","desc":"于谦立代宗、率军却也先，再造社稷。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1457","t":"夺门之变","desc":"英宗复辟，于谦含冤被害。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1521","t":"大礼议","desc":"世宗与廷臣争生父名分，君权重张。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1561–66","t":"荡平倭患","desc":"戚继光台州大捷、俞大猷等转战闽广，东南倭患以次荡平。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1571","t":"俺答封贡","desc":"北虏与明议和互市，北疆渐安。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1572–82","t":"张居正改革","desc":"考成法、一条鞭法，国库充盈、万历中兴。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1592–98","t":"万历朝鲜战争","desc":"两度援朝抗日，终破丰臣秀吉之军。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1619","t":"萨尔浒之战","desc":"明军四路大败于后金，辽东局势逆转。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1644","t":"甲申之变","desc":"李自成破北京、崇祯自缢，清军入关，明亡。","dyName":"明","dyId":"ming","col":"#9c2b22"},{"y":"1636","t":"皇太极改国号","desc":"后金改称大清，整合满蒙汉八旗。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1644","t":"清军入关","desc":"吴三桂引清军入关、败李自成，迁都北京。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1673–81","t":"平定三藩","desc":"康熙削平吴三桂等三藩之乱，巩固统治。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1683","t":"收复台湾","desc":"施琅渡海、郑氏降清，旋设台湾府。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1689","t":"尼布楚条约","desc":"与沙俄议定东段边界，为中国首个对外平等条约。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1690–97","t":"亲征噶尔丹","desc":"康熙三征准噶尔，稳定漠北。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1729","t":"设军机处","desc":"雍正设军机处，皇权高度集中。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1757","t":"一口通商","desc":"乾隆限定广州一口对外通商，闭关渐深。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1772–82","t":"编《四库全书》","desc":"集古籍之大成，亦借机禁毁书籍。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1840–42","t":"鸦片战争","desc":"英国发动战争，败后签《南京条约》、割香港。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1851–64","t":"太平天国","desc":"洪秀全起事、建天京，历时十余年震动半壁。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1856–60","t":"第二次鸦片战争","desc":"英法联军入北京、焚圆明园，再签不平等条约。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1861–95","t":"洋务运动","desc":"奕䜣与曾左李等兴办军工实业，\"师夷长技\"。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1894–95","t":"甲午战争","desc":"败于日本、签《马关条约》，洋务破产、割台湾。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1898","t":"戊戌变法","desc":"光绪行新政百日，旋为慈禧政变所废。","dyName":"清","dyId":"qing","col":"#c9a227"},{"y":"1911–12","t":"辛亥革命","desc":"武昌起义、各省独立，1912年宣统退位，清亡。","dyName":"清","dyId":"qing","col":"#c9a227"}],"dynasties":[{"id":"xia","name":"夏","full":"夏朝","s":-2070,"e":-1600,"col":"#6b7a52"},{"id":"shang","name":"商","full":"商朝","s":-1600,"e":-1046,"col":"#7a5c3e"},{"id":"xizhou","name":"西周","full":"西周","s":-1046,"e":-771,"col":"#9c6b3f"},{"id":"dongzhou","name":"东周","full":"东周（春秋·战国）","s":-770,"e":-221,"col":"#b08a3e"},{"id":"qin","name":"秦","full":"秦朝","s":-221,"e":-207,"col":"#2f2f33"},{"id":"xihan","name":"西汉","full":"西汉","s":-202,"e":9,"col":"#3a4a6b"},{"id":"xin","name":"新","full":"新朝","s":9,"e":23,"col":"#5a5570"},{"id":"donghan","name":"东汉","full":"东汉","s":25,"e":220,"col":"#3a567a"},{"id":"wei","name":"曹魏","full":"曹魏","s":220,"e":266,"col":"#7a3b3b"},{"id":"shu","name":"蜀汉","full":"蜀汉","s":221,"e":263,"col":"#9c2b22"},{"id":"wu","name":"孙吴","full":"孙吴","s":222,"e":280,"col":"#3f7a6b"},{"id":"xijin","name":"西晋","full":"西晋","s":266,"e":316,"col":"#5a6b7a"},{"id":"dongjin","name":"东晋","full":"东晋","s":317,"e":420,"col":"#6b7a8a"},{"id":"sixteen","name":"十六国","full":"十六国","s":304,"e":439,"col":"#8a6b5a"},{"id":"nanchao","name":"南朝","full":"南朝（宋齐梁陈）","s":420,"e":589,"col":"#6b5a7a"},{"id":"beichao","name":"北朝","full":"北朝（北魏·齐周）","s":439,"e":581,"col":"#5a6e8a"},{"id":"sui","name":"隋","full":"隋朝","s":581,"e":618,"col":"#4e7a6b"},{"id":"tang","name":"唐","full":"唐朝","s":618,"e":907,"col":"#b8392c"},{"id":"wudai","name":"五代","full":"五代（梁唐晋汉周）","s":907,"e":960,"col":"#8a6b4a"},{"id":"shiguo","name":"十国","full":"十国","s":902,"e":979,"col